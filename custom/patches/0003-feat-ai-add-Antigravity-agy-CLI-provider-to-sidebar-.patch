+            if (lines.length > 20)
+                err = lines.slice(lines.length - 20).join("\n");
+            st.acc = "⚠️ Antigravity exited with code " + code + "."
+                + (err !== "" ? "\n\n```\n" + err + "\n```" : "\n\nIs the `agy` CLI installed and logged in? Try running `agy login` in a terminal.");
+        }
+    }
+    return finish(st);
+}
