From 4bb4ce655274b2c5867bf2ec24eeabd53015ebc8 Mon Sep 17 00:00:00 2001
From: Febryan Grady <febryan.grady@binus.edu>
Date: Mon, 16 Nov 2026 01:27:24 +0700
Subject: [PATCH 11/47] fix(launcher): prevent ContentList opacity from getting
 stuck mid-fade

---
 shell/modules/launcher/ContentList.qml | 26 ++++++++++++++++++++++++--
 1 file changed, 24 insertions(+), 2 deletions(-)

diff --git a/shell/modules/launcher/ContentList.qml b/shell/modules/launcher/ContentList.qml
index 6c100551..852245ab 100644
--- a/shell/modules/launcher/ContentList.qml
+++ b/shell/modules/launcher/ContentList.qml
@@ -176,14 +176,36 @@ Item {
         }
     }
 
+    onStateChanged: {
+        if (!stateBehavior.enabled && !stateTransitionAnim.running)
+            root.opacity = 1;
+    }
+
+    Connections {
+        function onLauncherChanged(): void {
+            if (root.visibilities.launcher && !stateTransitionAnim.running)
+                root.opacity = 1;
+        }
+
+        target: root.visibilities
+    }
+
     Behavior on state {
-        enabled: root.visibilities.launcher && !root.visibilities.skipLauncherAnim && root.opacity === 1
+        id: stateBehavior
+
+        enabled: root.visibilities.launcher && !root.visibilities.skipLauncherAnim
 
         SequentialAnimation {
+            id: stateTransitionAnim
+
+            onRunningChanged: {
+                if (!running)
+                    root.opacity = 1;
+            }
+
             Anim {
                 target: root
                 property: "opacity"
-                from: 1
                 to: 0
                 type: Anim.DefaultEffects
             }
-- 
2.56.1

