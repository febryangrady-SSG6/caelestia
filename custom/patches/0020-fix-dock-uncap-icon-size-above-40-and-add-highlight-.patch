From fab1ba331c5db8744eb4041f50aa432f27ca7c4f Mon Sep 17 00:00:00 2001
From: Febryan Grady <febryan.grady@binus.edu>
Date: Tue, 24 Nov 2026 23:01:34 +0700
Subject: [PATCH 20/47] fix(dock): uncap icon size above 40 and add highlight
 padding

---
 shell/modules/bar/BarWidgets.qml              | 25 +++++++++++++++++++
 shell/modules/bar/BarWrapper.qml              |  4 ++-
 shell/modules/bar/components/Dock.qml         | 14 +++++------
 .../nexus/pages/panels/taskbar/BarDock.qml    |  2 +-
 4 files changed, 36 insertions(+), 9 deletions(-)

diff --git a/shell/modules/bar/BarWidgets.qml b/shell/modules/bar/BarWidgets.qml
index 82bf23f5..5250a47f 100644
--- a/shell/modules/bar/BarWidgets.qml
+++ b/shell/modules/bar/BarWidgets.qml
@@ -345,4 +345,30 @@ QtObject {
         }
         return hidden;
     }
+
+    function dockIconSize(configuredSize: real): int {
+        const raw = configuredSize > 0 ? configuredSize : 32;
+        return Math.max(16, Math.round(raw / 2) * 2);
+    }
+
+    function dockItemSize(iconSize: real): int {
+        // Leave enough margin around the icon so the highlight tile never
+        // cramps full-bleed squircle icons or the bottom running indicator.
+        const pad = Math.max(6, Math.round(iconSize * 0.16));
+        return Math.round(iconSize + pad * 2);
+    }
+
+    function dockContainerThickness(baseThickness: real, itemSize: real, crossPadding: real): int {
+        // Keep cross-axis padding inside the dock pill around each highlight
+        // tile so the highlight never sits flush against the pill edge.
+        return Math.max(Math.round(baseThickness), Math.round(itemSize + crossPadding * 2));
+    }
+
+    function dockThicknessFor(barConfig: var, baseThickness: real, crossPadding: real): int {
+        const dockEntry = entriesOf(barConfig).find(entry => entry.id === "dock");
+        if (!dockEntry || !dockEntry.enabled)
+            return 0;
+        const iconSize = dockIconSize(barConfig.dock?.iconSize ?? 32);
+        return dockContainerThickness(baseThickness, dockItemSize(iconSize), crossPadding);
+    }
 }
diff --git a/shell/modules/bar/BarWrapper.qml b/shell/modules/bar/BarWrapper.qml
index 30b7c2c7..0c31c30f 100755
--- a/shell/modules/bar/BarWrapper.qml
+++ b/shell/modules/bar/BarWrapper.qml
@@ -25,7 +25,9 @@ Item {
     readonly property int islandMargin: isIsland ? Tokens.spacing.extraLarge : 0
     readonly property real barScale: Math.max(0.6, !isNaN(Config.bar.scale) ? Config.bar.scale : 1.0)
     readonly property int padding: Math.max(Tokens.padding.small, Config.border.thickness)
-    readonly property int contentWidth: Math.round(Tokens.sizes.bar.innerWidth * barScale) + padding * 2
+    readonly property int baseInnerThickness: Math.round(Tokens.sizes.bar.innerWidth * barScale)
+    readonly property int dockThickness: BarWidgets.dockThicknessFor(Config.bar, baseInnerThickness, Tokens.padding.extraSmall)
+    readonly property int contentWidth: Math.max(baseInnerThickness, dockThickness) + padding * 2
     readonly property bool dodgeEnabled: Config.bar.dodgeWindows && Config.bar.persistent && !disabled
     // The strip the bar occupies, in the absolute multi-monitor coordinates
     // KWin reports window geometry in — hence the screen origin offset.
diff --git a/shell/modules/bar/components/Dock.qml b/shell/modules/bar/components/Dock.qml
index 5b205f16..79b294d3 100644
--- a/shell/modules/bar/components/Dock.qml
+++ b/shell/modules/bar/components/Dock.qml
@@ -16,6 +16,7 @@ import qs.components.images
 import qs.components.widgets
 import qs.services
 import qs.utils
+import qs.modules.bar
 
 Item {
     id: root
@@ -24,17 +25,16 @@ Item {
 
     property real spacing: Tokens.spacing.medium
 
-    property real padding: Tokens.padding.medium
+    property real padding: Math.max(Tokens.padding.medium, Math.round(configuredItemSize * 0.22))
 
     readonly property real rawScale: !isNaN(Config.bar.scale) ? Config.bar.scale : 1.0
     readonly property real scaleFactor: rawScale < 1.0 ? Math.sqrt(Math.max(0.1, rawScale)) : rawScale
     readonly property int barThickness: Math.round(Tokens.sizes.bar.innerWidth * scaleFactor)
     readonly property int baseThickness: Tokens.sizes.bar.innerWidth
     readonly property int effectiveThickness: rawScale < 1.0 ? baseThickness : barThickness
-    readonly property real configuredItemSize: Math.max(16, Math.min(effectiveThickness, Config.bar.dock.iconSize || 32))
-    // Icon size of a dock item. Derived from the configured item size rather than the
-    // delegate's laid-out width, which is still 0 while the delegate is being created.
-    readonly property real iconSize: Math.round(configuredItemSize * 0.7 / 2) * 2
+    readonly property real iconSize: BarWidgets.dockIconSize(Config.bar.dock.iconSize)
+    readonly property real configuredItemSize: BarWidgets.dockItemSize(iconSize)
+    readonly property int containerThickness: BarWidgets.dockContainerThickness(effectiveThickness, configuredItemSize, Tokens.padding.extraSmall)
 
     function publishMinimizeGeometry(): void {
         const win = QsWindow.window;
@@ -250,8 +250,8 @@ Item {
 
         color: DockManager.count > 0 ? Colours.tPalette.m3surfaceContainer : Qt.alpha(Colours.tPalette.m3surfaceContainer, 0)
         radius: Tokens.rounding.full
-        implicitWidth: bar.isHorizontal ? (__computedContentWidth + padding * 2) : bar.thickness
-        implicitHeight: bar.isHorizontal ? bar.thickness : (__computedContentWidth + padding * 2)
+        implicitWidth: bar.isHorizontal ? (__computedContentWidth + padding * 2) : root.containerThickness
+        implicitHeight: bar.isHorizontal ? root.containerThickness : (__computedContentWidth + padding * 2)
         width: bar.isHorizontal ? Math.min(implicitWidth, maxHorizontalSize) : implicitWidth
         height: !bar.isHorizontal ? Math.min(implicitHeight, maxVerticalSize) : implicitHeight
 
diff --git a/shell/modules/nexus/pages/panels/taskbar/BarDock.qml b/shell/modules/nexus/pages/panels/taskbar/BarDock.qml
index 1d3c4522..b837eab1 100644
--- a/shell/modules/nexus/pages/panels/taskbar/BarDock.qml
+++ b/shell/modules/nexus/pages/panels/taskbar/BarDock.qml
@@ -44,7 +44,7 @@ PageBase {
             reset: ({ node: GlobalConfig.bar.dock, setting: "iconSize" })
             value: Config.bar.dock.iconSize
             from: 20
-            to: Math.max(20, Tokens.sizes.bar.innerWidth)
+            to: 64
             stepSize: 2
             onMoved: v => GlobalConfig.bar.dock.iconSize = v
         }
