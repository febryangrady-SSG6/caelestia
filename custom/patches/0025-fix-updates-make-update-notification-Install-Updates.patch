From 73c4969bfdb5811fe0aaef0bbd789d7c5f97dca0 Mon Sep 17 00:00:00 2001
From: Febryan Grady <febryan.grady@binus.edu>
Date: Sat, 21 Nov 2026 13:09:58 +0700
Subject: [PATCH 25/47] fix(updates): make update notification Install Updates
 action work reliably

---
 shell/modules/notifications/Notification.qml |  2 +-
 shell/modules/sidebar/NotifActionList.qml    |  6 ++--
 shell/services/NotifData.qml                 | 31 +++++++++++++++++++-
 src/bin/caelestia-check-updates              | 22 +++++++++++---
 4 files changed, 51 insertions(+), 10 deletions(-)

diff --git a/shell/modules/notifications/Notification.qml b/shell/modules/notifications/Notification.qml
index 5c305efc..f420a18b 100644
--- a/shell/modules/notifications/Notification.qml
+++ b/shell/modules/notifications/Notification.qml
@@ -567,7 +567,7 @@ StyledRect {
                             inactiveColour: "transparent"
                             inactiveOnColour: root.isCritical ? Colours.palette.m3onSecondary : Colours.palette.m3onSurface
                             text: modelData.text
-                            onClicked: modelData.invoke()
+                            onClicked: root.modelData.invokeAction(modelData)
 
                             label.horizontalAlignment: Text.AlignLeft
                             label.anchors.left: left
diff --git a/shell/modules/sidebar/NotifActionList.qml b/shell/modules/sidebar/NotifActionList.qml
index cdaef627..c4ab5b40 100644
--- a/shell/modules/sidebar/NotifActionList.qml
+++ b/shell/modules/sidebar/NotifActionList.qml
@@ -143,10 +143,8 @@ Item {
                                 Quickshell.clipboardText = root.notif.body;
                                 actionInner.item.text = "inventory";
                                 copyTimer.start();
-                            } else if (action.modelData.invoke) {
-                                action.modelData.invoke();
-                            } else if (!root.notif.resident) {
-                                root.notif.close();
+                            } else {
+                                root.notif.invokeAction(action.modelData);
                             }
                         }
                     }
diff --git a/shell/services/NotifData.qml b/shell/services/NotifData.qml
index a0eab86e..c937f2c4 100644
--- a/shell/services/NotifData.qml
+++ b/shell/services/NotifData.qml
@@ -255,7 +255,7 @@ QtObject {
             ?? actions.find(a => a.identifier === "run")
             ?? (actions.length === 1 ? actions[0] : null);
         if (action) {
-            action.invoke();
+            invokeAction(action);
             return true;
         }
 
@@ -290,6 +290,35 @@ QtObject {
         notification.sendInlineReply(trimmed);
     }
 
+    function invokeAction(action: var): void {
+        if (!action)
+            return;
+
+        if (appName === "Caelestia Updates") {
+            const actionId = String(action.identifier ?? "");
+            if (actionId === "close") {
+                close();
+                return;
+            }
+            if (actionId === "run") {
+                const isUiUpdate = summary.includes("Caelestia") || summary.includes("UI") || bodyPlain.includes("commits");
+                if (isUiUpdate) {
+                    Quickshell.execDetached(["qs", "-c", "caelestia", "ipc", "call", "nexus", "openPage", "updates", "-1"]);
+                } else {
+                    const cmd = 'if command -v yay >/dev/null 2>&1; then yay -Syu; elif command -v pacman >/dev/null 2>&1; then sudo pacman -Syu; fi; s=$?; if command -v flatpak >/dev/null 2>&1; then flatpak update; fi; printf "\\n[system update exited with status %s] Press Enter to close..." "$s"; read -r _';
+                    Launch.exec([...Launch.terminalExecPrefix([]), "sh", "-c", cmd]);
+                }
+                close();
+                return;
+            }
+        }
+
+        if (typeof action.invoke === "function")
+            action.invoke();
+        else if (!resident)
+            close();
+    }
+
     function lock(item: Item): void {
         locks.add(item);
     }
diff --git a/src/bin/caelestia-check-updates b/src/bin/caelestia-check-updates
index 84ecd928..3fa65bfe 100755
--- a/src/bin/caelestia-check-updates
+++ b/src/bin/caelestia-check-updates
@@ -153,10 +153,24 @@ if [ "$CAELESTIA_PENDING" -gt "${OLD_C:-0}" ] || [ "$SYSTEM_PENDING" -gt "${OLD_
 
         ACTION=$(echo "$NOTIF_OUT" | sed -n '2p')
         if [ "$ACTION" = "run" ]; then
-            if [ -x "$HOME/.local/bin/caelestia" ]; then
-                "$HOME/.local/bin/caelestia" shell toggleNexus &
-            elif command -v caelestia &> /dev/null; then
-                caelestia shell toggleNexus &
+            if [ "$CAELESTIA_PENDING" -gt 0 ]; then
+                if [ -x "$HOME/.local/bin/caelestia" ]; then
+                    "$HOME/.local/bin/caelestia" shell nexus openPage updates -1 &
+                elif command -v caelestia &> /dev/null; then
+                    caelestia shell nexus openPage updates -1 &
+                fi
+            else
+                TERM_CMD=""
+                if command -v jq >/dev/null && [ -f "$HOME/.config/caelestia/shell.json" ]; then
+                    TERM_CMD=$(jq -r '.general.apps.terminal[0] // empty' "$HOME/.config/caelestia/shell.json" 2>/dev/null)
+                fi
+                TERM_CMD="${TERM_CMD:-konsole}"
+                UPDATE_SCRIPT='if command -v yay >/dev/null 2>&1; then yay -Syu; elif command -v pacman >/dev/null 2>&1; then sudo pacman -Syu; fi; s=$?; if command -v flatpak >/dev/null 2>&1; then flatpak update; fi; printf "\n[system update exited with status %s] Press Enter to close..." "$s"; read -r _'
+                if [ "$(basename "$TERM_CMD")" = "konsole" ]; then
+                    "$TERM_CMD" -e sh -c "$UPDATE_SCRIPT" &
+                else
+                    "$TERM_CMD" sh -c "$UPDATE_SCRIPT" &
+                fi
             fi
         fi
     fi
-- 
2.56.1

