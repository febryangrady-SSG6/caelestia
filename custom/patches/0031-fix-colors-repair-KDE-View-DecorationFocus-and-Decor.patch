From fb6b0eafde78bfbe10c1ed37f05a161433f10daf Mon Sep 17 00:00:00 2001
From: Febryan Grady <febryan.grady@binus.edu>
Date: Sat, 21 Nov 2026 22:17:02 +0700
Subject: [PATCH 31/47] fix(colors): repair KDE View DecorationFocus and
 DecorationHover contrast

---
 src/bin/caelestia-color | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/src/bin/caelestia-color b/src/bin/caelestia-color
index 40620d61..77cc34fd 100755
--- a/src/bin/caelestia-color
+++ b/src/bin/caelestia-color
@@ -853,6 +853,10 @@ def cmd_kde_selection(scheme_file: str, colors_file: str) -> int:
             elif key == "ForegroundInactive" and (len(val_hex) != 6 or contrast_ratio(primary, val_hex) < 4.5):
                 lines[index] = f"ForegroundInactive=#{sel_inactive}"
                 changed = True
+        elif section == "[Colors:View]" and len(primary) == 6 and sel_fg and key in ("DecorationFocus", "DecorationHover"):
+            if len(val_hex) != 6 or contrast_ratio(val_hex, sel_fg) < 4.5:
+                lines[index] = f"{key}=#{primary}"
+                changed = True
         elif section == "[Colors:Complementary]" and comp_fg and key == "ForegroundNormal":
             if len(val_hex) != 6 or contrast_ratio(surface, val_hex) < 4.5:
                 lines[index] = f"ForegroundNormal=#{comp_fg}"
-- 
