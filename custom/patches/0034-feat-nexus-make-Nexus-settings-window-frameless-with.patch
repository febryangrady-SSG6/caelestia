From 0698be9bce50080b7bcca631c71d4ac16d2a7f1b Mon Sep 17 00:00:00 2001
From: Febryan Grady <febryan.grady@binus.edu>
Date: Sun, 22 Nov 2026 00:22:00 +0700
Subject: [PATCH 34/47] feat(nexus): make Nexus settings window frameless with
 seamless glass header and rounded blur

---
 shell/modules/nexus/Nexus.qml         |   8 +-
 shell/modules/nexus/WindowFactory.qml | 191 ++++++++++++++++++++++++--
 2 files changed, 184 insertions(+), 15 deletions(-)

diff --git a/shell/modules/nexus/Nexus.qml b/shell/modules/nexus/Nexus.qml
index f0c4f910..6e3a83e0 100644
--- a/shell/modules/nexus/Nexus.qml
+++ b/shell/modules/nexus/Nexus.qml
@@ -17,6 +17,7 @@ Item {
 
     property int initialPageIdx: 0
     property string initialSubPage: ""
+    property real topInset: 0
     readonly property bool windowActive: Window.window ? Window.window.active : false
     readonly property bool sidePane: GlobalConfig.nexus.sidePane
 
@@ -247,7 +248,7 @@ Item {
 
         borderLeft: pages.x - Tokens.padding.small
         borderRight: Tokens.padding.medium
-        borderTop: Tokens.padding.medium
+        borderTop: Tokens.padding.medium + root.topInset
         borderBottom: Tokens.padding.medium
     }
 
@@ -258,6 +259,7 @@ Item {
         anchors.bottom: parent.bottom
         anchors.left: parent.left
         anchors.margins: Tokens.padding.large
+        anchors.topMargin: Tokens.padding.large + root.topInset
 
         nState: nState
         width: root.navPaneWidth()
@@ -288,7 +290,7 @@ Item {
         anchors.top: parent.top
         anchors.bottom: parent.bottom
         anchors.leftMargin: Tokens.padding.large
-        anchors.topMargin: navPane.anchors.margins
+        anchors.topMargin: navPane.anchors.topMargin
         anchors.bottomMargin: navPane.anchors.margins
 
         width: root.compact ? Math.min(340, Math.round(root.width * 0.45)) : Math.min(300, Math.round(root.width * 0.22))
@@ -312,7 +314,7 @@ Item {
         anchors.top: parent.top
         anchors.bottom: parent.bottom
         anchors.leftMargin: Tokens.padding.large
-        anchors.topMargin: navPane.anchors.margins
+        anchors.topMargin: navPane.anchors.topMargin
         anchors.bottomMargin: navPane.anchors.margins
         anchors.rightMargin: navPane.anchors.margins
 
diff --git a/shell/modules/nexus/WindowFactory.qml b/shell/modules/nexus/WindowFactory.qml
index a023d3bb..7f8ad352 100644
--- a/shell/modules/nexus/WindowFactory.qml
+++ b/shell/modules/nexus/WindowFactory.qml
@@ -1,12 +1,16 @@
 pragma Singleton
 
 import QtQuick
+import QtQuick.Layouts
+import QtQuick.Window
 import Quickshell
 import Quickshell.Wayland
 import Caelestia.Config
 import qs.components
+import qs.components.controls
 import qs.services
 import qs.utils
+import qs.modules.drawers.blur
 import qs.modules.nexus
 
 Singleton {
@@ -113,19 +117,25 @@ Singleton {
                     root.openWindow = null;
             }
 
-            color: Colours.tPalette.m3surface
-            // Commented because nexus bg depends on the above
-            // color: GlobalConfig.appearance.transparency.enabled ? Qt.alpha(Colours.tPalette.m3surface, 0) : Colours.tPalette.m3surface
+            readonly property real cornerRadius: win.maximized ? 0 : Tokens.rounding.large
+
+            color: "transparent"
 
             surfaceFormat.opaque: false
 
             BackgroundEffect.blurRegion: Region {
                 Region { x: -10; y: -10; width: 1; height: 1 }
-                Region { item: (GlobalConfig.appearance.transparency.enabled && GlobalConfig.appearance.blur) ? nexus : null }
+                BlurMask {
+                    target: (GlobalConfig.appearance.transparency.enabled && GlobalConfig.appearance.blur) ? winClip : null
+                    contentItem: win.contentItem
+                    vAnchor: "none"
+                    hAnchor: "none"
+                    radius: win.cornerRadius
+                }
             }
 
             implicitWidth: nexus.implicitWidth
-            implicitHeight: nexus.implicitHeight
+            implicitHeight: nexus.implicitHeight + titleBar.implicitHeight
 
             minimumSize.width: Math.max(1050, Tokens.sizes.nexus.minWidth)
             minimumSize.height: Tokens.sizes.nexus.minHeight
@@ -135,15 +145,172 @@ Singleton {
 
             title: PageRegistry.pages[nexus.nState.currentPageIdx] ? PageRegistry.pages[nexus.nState.currentPageIdx].label : "Nexus"
 
-            Nexus {
-                id: nexus
+            Component.onCompleted: {
+                const w = winRoot.Window.window;
+                if (w)
+                    w.flags |= Qt.FramelessWindowHint;
+            }
+
+            Item {
+                id: winRoot
 
                 anchors.fill: parent
-                initialPageIdx: win.initialPageIdx
-                initialSubPage: win.initialSubPage
-                nState.screen: win.screen ?? Screens.activeScreen ?? Quickshell.screens[0]
-                nState.isWindow: true
-                onClose: win.visible = false
+
+                StyledClippingRect {
+                    id: winClip
+
+                    anchors.fill: parent
+                    radius: win.cornerRadius
+                    color: Colours.tPalette.m3surface
+
+                    Nexus {
+                        id: nexus
+
+                        anchors.fill: parent
+                        topInset: titleBar.height
+                        initialPageIdx: win.initialPageIdx
+                        initialSubPage: win.initialSubPage
+                        nState.screen: win.screen ?? Screens.activeScreen ?? Quickshell.screens[0]
+                        nState.isWindow: true
+                        onClose: win.visible = false
+                    }
+
+                    Item {
+                        id: titleBar
+
+                        anchors.top: parent.top
+                        anchors.left: parent.left
+                        anchors.right: parent.right
+                        height: 36
+                        implicitHeight: 36
+                        z: 20
+
+                        MouseArea {
+                            anchors.fill: parent
+                            acceptedButtons: Qt.LeftButton
+                            onPressed: win.startSystemMove()
+                            onDoubleClicked: win.maximized = !win.maximized
+                        }
+
+                        RowLayout {
+                            anchors.fill: parent
+                            anchors.leftMargin: Tokens.padding.large
+                            anchors.rightMargin: Tokens.padding.small
+                            spacing: Tokens.spacing.small
+
+                            MaterialIcon {
+                                text: PageRegistry.pages[nexus.nState.currentPageIdx]?.icon ?? "settings"
+                                color: Colours.palette.m3onSurfaceVariant
+                                fontStyle: Tokens.font.icon.small
+                            }
+
+                            StyledText {
+                                Layout.fillWidth: true
+                                text: win.title
+                                color: Colours.palette.m3onSurfaceVariant
+                                font: Tokens.font.label.medium
+                                elide: Text.ElideRight
+                            }
+
+                            Item {
+                                id: minBtn
+
+                                implicitWidth: 28
+                                implicitHeight: 28
+
+                                StateLayer {
+                                    radius: Tokens.rounding.full
+                                    onClicked: win.minimized = true
+                                }
+
+                                MaterialIcon {
+                                    anchors.centerIn: parent
+                                    text: "remove"
+                                    color: Colours.palette.m3onSurfaceVariant
+                                    fontStyle: Tokens.font.icon.small
+                                }
+                            }
+
+                            Item {
+                                id: maxBtn
+
+                                implicitWidth: 28
+                                implicitHeight: 28
+
+                                StateLayer {
+                                    radius: Tokens.rounding.full
+                                    onClicked: win.maximized = !win.maximized
+                                }
+
+                                MaterialIcon {
+                                    anchors.centerIn: parent
+                                    text: win.maximized ? "filter_none" : "crop_square"
+                                    color: Colours.palette.m3onSurfaceVariant
+                                    fontStyle: Tokens.font.icon.small
+                                }
+                            }
+
+                            Item {
+                                id: closeBtn
+
+                                implicitWidth: 28
+                                implicitHeight: 28
+
+                                StateLayer {
+                                    id: closeState
+
+                                    radius: Tokens.rounding.full
+                                    color: Colours.palette.m3error
+                                    onClicked: win.visible = false
+                                }
+
+                                MaterialIcon {
+                                    anchors.centerIn: parent
+                                    text: "close"
+                                    color: closeState.containsMouse ? Colours.palette.m3error : Colours.palette.m3onSurfaceVariant
+                                    fontStyle: Tokens.font.icon.small
+                                }
+                            }
+                        }
+                    }
+                }
+
+                // Subtle glass rim around frameless window
+                Rectangle {
+                    anchors.fill: parent
+                    visible: !win.maximized
+                    radius: win.cornerRadius
+                    color: "transparent"
+                    border.width: 1
+                    border.color: Qt.alpha(Colours.palette.m3outlineVariant, 0.35)
+                    z: 999
+                }
+
+                // Invisible resize grips for frameless window edges & corners
+                Repeater {
+                    model: win.maximized ? [] : [
+                        { edges: Qt.TopEdge, cursor: Qt.SizeVerCursor, x: 6, y: 0, w: -12, h: 5 },
+                        { edges: Qt.BottomEdge, cursor: Qt.SizeVerCursor, x: 6, y: -5, w: -12, h: 5 },
+                        { edges: Qt.LeftEdge, cursor: Qt.SizeHorCursor, x: 0, y: 6, w: 5, h: -12 },
+                        { edges: Qt.RightEdge, cursor: Qt.SizeHorCursor, x: -5, y: 6, w: 5, h: -12 },
+                        { edges: Qt.TopEdge | Qt.LeftEdge, cursor: Qt.SizeFDiagCursor, x: 0, y: 0, w: 8, h: 8 },
+                        { edges: Qt.TopEdge | Qt.RightEdge, cursor: Qt.SizeBDiagCursor, x: -8, y: 0, w: 8, h: 8 },
+                        { edges: Qt.BottomEdge | Qt.LeftEdge, cursor: Qt.SizeBDiagCursor, x: 0, y: -8, w: 8, h: 8 },
+                        { edges: Qt.BottomEdge | Qt.RightEdge, cursor: Qt.SizeFDiagCursor, x: -8, y: -8, w: 8, h: 8 }
+                    ]
+
+                    MouseArea {
+                        required property var modelData
+
+                        x: modelData.x < 0 ? winRoot.width + modelData.x : modelData.x
+                        y: modelData.y < 0 ? winRoot.height + modelData.y : modelData.y
+                        width: modelData.w < 0 ? winRoot.width + modelData.w : modelData.w
+                        height: modelData.h < 0 ? winRoot.height + modelData.h : modelData.h
+                        cursorShape: modelData.cursor
+                        z: 1000
+                        onPressed: win.startSystemResize(modelData.edges)
+                    }
+                }
             }
 
             Behavior on color {
-- 
2.56.1

