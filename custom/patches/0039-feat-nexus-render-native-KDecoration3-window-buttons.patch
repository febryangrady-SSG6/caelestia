+QList<DecorationButtonType> parseWindowControlButtons(const QString& str) {
+    QList<DecorationButtonType> list;
+    for (const QChar& ch : str) {
+        if (ch == QLatin1Char('I') && !list.contains(DecorationButtonType::Minimize)) {
+            list.append(DecorationButtonType::Minimize);
+        } else if (ch == QLatin1Char('A') && !list.contains(DecorationButtonType::Maximize)) {
+            list.append(DecorationButtonType::Maximize);
+        } else if (ch == QLatin1Char('X') && !list.contains(DecorationButtonType::Close)) {
+            list.append(DecorationButtonType::Close);
+        }
+    }
+    return list;
+}
+
+BorderSize parseBorderSize(const QString& str) {
+    if (str == QLatin1String("None"))
+        return BorderSize::None;
+    if (str == QLatin1String("NoSides"))
+        return BorderSize::NoSides;
+    if (str == QLatin1String("Tiny"))
+        return BorderSize::Tiny;
+    if (str == QLatin1String("Large"))
+        return BorderSize::Large;
+    if (str == QLatin1String("VeryLarge"))
+        return BorderSize::VeryLarge;
+    if (str == QLatin1String("Huge"))
+        return BorderSize::Huge;
+    if (str == QLatin1String("VeryHuge"))
+        return BorderSize::VeryHuge;
+    if (str == QLatin1String("Oversized"))
+        return BorderSize::Oversized;
+    return BorderSize::Normal;
+}
+
+} // namespace
