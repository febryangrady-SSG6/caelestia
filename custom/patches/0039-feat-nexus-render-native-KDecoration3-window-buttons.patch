+KdeDecorationButtons::KdeDecorationButtons(QQuickItem* parent)
+    : QQuickPaintedItem(parent)
+    , m_bridge(std::make_unique<KdeDecoBridge>(this)) {
+    setAcceptHoverEvents(true);
+    setAcceptedMouseButtons(Qt::LeftButton);
+    setAntialiasing(true);
+}
+
+KdeDecorationButtons::~KdeDecorationButtons() = default;
+
+void KdeDecorationButtons::setSide(const QString& side) {
+    const QString norm = (side == QLatin1String("left")) ? QStringLiteral("left") : QStringLiteral("right");
+    if (m_side == norm)
+        return;
+    m_side = norm;
+    emit sideChanged();
+    if (m_completed)
+        reloadDecoration();
+}
+
+void KdeDecorationButtons::setWindowActive(bool active) {
+    if (m_windowActive == active)
+        return;
+    m_windowActive = active;
+    emit windowActiveChanged();
+    if (auto* w = m_bridge->lastWindow()) {
+        if (auto* dw = w->decoratedWindow())
+            emit dw->activeChanged(active);
+    }
+    update();
+}
+
+void KdeDecorationButtons::setWindowMaximized(bool maximized) {
+    if (m_windowMaximized == maximized)
+        return;
+    m_windowMaximized = maximized;
+    emit windowMaximizedChanged();
+    if (auto* w = m_bridge->lastWindow()) {
+        if (auto* dw = w->decoratedWindow()) {
+            emit dw->maximizedHorizontallyChanged(maximized);
+            emit dw->maximizedVerticallyChanged(maximized);
+            emit dw->maximizedChanged(maximized);
+        }
+    }
+    if (m_decoration) {
+        if (auto st = m_decoration->nextState())
+            m_decoration->apply(st->clone());
+    }
+    for (const auto& b : m_buttons) {
+        if (b && b->type() == DecorationButtonType::Maximize)
+            b->setChecked(maximized);
+    }
+    recalculateBounds();
+}
+
+QList<DecorationButtonType> KdeDecorationButtons::activeButtonsLeft() const {
+    return (m_side == QLatin1String("left")) ? m_buttonsList : QList<DecorationButtonType>{};
+}
+
+QList<DecorationButtonType> KdeDecorationButtons::activeButtonsRight() const {
+    return (m_side == QLatin1String("right")) ? m_buttonsList : QList<DecorationButtonType>{};
+}
+
+void KdeDecorationButtons::notifyMinimizeRequested() {
+    clearHoverState();
+    emit minimizeRequested();
+}
+
+void KdeDecorationButtons::notifyMaximizeRequested() {
+    emit maximizeRequested();
+}
+
+void KdeDecorationButtons::notifyCloseRequested() {
+    clearHoverState();
+    emit closeRequested();
+}
+
+void KdeDecorationButtons::componentComplete() {
+    QQuickPaintedItem::componentComplete();
+    m_completed = true;
+    reloadDecoration();
+}
+
+void KdeDecorationButtons::reloadDecoration() {
+    auto kwinCfg = KSharedConfig::openConfig(QStringLiteral("kwinrc"));
+    KConfigGroup kdecGroup(kwinCfg, QStringLiteral("org.kde.kdecoration2"));
+
+    QString pluginId = kdecGroup.readEntry("library", QStringLiteral("org.kde.breeze"));
+    QString themeName = kdecGroup.readEntry("theme", QString());
+    m_borderSize = parseBorderSize(kdecGroup.readEntry("BorderSize", QStringLiteral("Normal")));
+
+    QString leftStr = kdecGroup.readEntry("ButtonsOnLeft", QStringLiteral("MS"));
+    QString rightStr = kdecGroup.readEntry("ButtonsOnRight", QStringLiteral("HIAX"));
+
+    // If an Aurorae theme is active and custom button positions weren't set in kwinrc,
+    // check the Aurorae theme's own rc file for default LeftButtons / RightButtons.
+    if (themeName.startsWith(QLatin1String("__aurorae__svg__"))
+        && !kdecGroup.hasKey("ButtonsOnLeft") && !kdecGroup.hasKey("ButtonsOnRight")) {
+        const QString auroraeName = themeName.mid(16);
+        const QString rcRel = QStringLiteral("aurorae/themes/") + auroraeName + QLatin1Char('/') + auroraeName + QStringLiteral("rc");
+        const QString rcPath = QStandardPaths::locate(QStandardPaths::GenericDataLocation, rcRel);
+        if (!rcPath.isEmpty()) {
+            auto themeCfg = KSharedConfig::openConfig(rcPath, KConfig::SimpleConfig);
+            KConfigGroup gen(themeCfg, QStringLiteral("General"));
+            if (gen.hasKey("LeftButtons") || gen.hasKey("RightButtons")) {
+                leftStr = gen.readEntry("LeftButtons", QString());
+                rightStr = gen.readEntry("RightButtons", QString());
+            }
+        }
+    }
+
+    QList<DecorationButtonType> leftBtns = parseWindowControlButtons(leftStr);
+    QList<DecorationButtonType> rightBtns = parseWindowControlButtons(rightStr);
+    if (leftBtns.isEmpty() && rightBtns.isEmpty()) {
+        rightBtns = {
+            DecorationButtonType::Minimize,
+            DecorationButtonType::Maximize,
+            DecorationButtonType::Close,
+        };
+    }
+
+    m_buttonsList = (m_side == QLatin1String("left")) ? leftBtns : rightBtns;
+
+    m_buttons.clear();
+    m_buttonsBounds = QRectF();
+    m_bridge->clearLastWindow();
+    m_decoration.reset();
+
+    if (m_buttonsList.isEmpty()) {
+        setImplicitSize(0, 0);
+        if (m_hasButtons) {
+            m_hasButtons = false;
+            emit hasButtonsChanged();
+        }
+        update();
+        return;
+    }
+
+    const auto plugins = KPluginMetaData::findPlugins(QStringLiteral("org.kde.kdecoration3"));
+    if (pluginId == QLatin1String("org.kde.kwin.aurorae")) {
+        for (const auto& md : plugins) {
+            if (md.pluginId() == QLatin1String("org.kde.kwin.aurorae.v2")) {
+                pluginId = QStringLiteral("org.kde.kwin.aurorae.v2");
+                break;
+            }
+        }
+    }
+
+    KPluginMetaData targetMd;
+    KPluginMetaData fallbackMd;
+    for (const auto& md : plugins) {
+        if (md.pluginId() == pluginId)
+            targetMd = md;
+        if (md.pluginId() == QLatin1String("org.kde.breeze"))
+            fallbackMd = md;
+    }
+    if (!targetMd.isValid())
+        targetMd = fallbackMd;
+
+    if (!targetMd.isValid()) {
+        setImplicitSize(0, 0);
+        if (m_hasButtons) {
+            m_hasButtons = false;
+            emit hasButtonsChanged();
+        }
+        update();
+        return;
+    }
+
+    if (kdecGroup.readEntry("BorderSizeAuto", true)) {
+        const QString recBorder = targetMd.rawData()
+            .value(QStringLiteral("org.kde.kdecoration3"))
+            .toObject()
+            .value(QStringLiteral("recommendedBorderSize"))
+            .toString(QStringLiteral("Normal"));
+        m_borderSize = parseBorderSize(recBorder);
+    }
+
+    auto factoryRes = KPluginFactory::loadFactory(targetMd);
+    if (!factoryRes.plugin)
+        return;
+
+    m_settings = std::make_shared<DecorationSettings>(m_bridge.get());
+
+    QVariantMap args({ { QStringLiteral("bridge"), QVariant::fromValue(static_cast<DecorationBridge*>(m_bridge.get())) } });
+    if (!themeName.isEmpty())
+        args.insert(QStringLiteral("theme"), themeName);
+
+    m_decoration.reset(factoryRes.plugin->create<Decoration>(nullptr, QVariantList({ args })));
+    if (!m_decoration)
+        return;
+
+    m_decoration->setSettings(m_settings);
+    m_decoration->create();
+    m_decoration->init();
+    if (auto st = m_decoration->nextState())
+        m_decoration->apply(st->clone());
+
+    connect(m_decoration.get(), &Decoration::nextStateChanged, this, [this](std::shared_ptr<DecorationState> st) {
+        if (m_decoration && st) {
+            m_decoration->apply(st->clone());
+            recalculateBounds();
+        }
+    });
+    connect(m_decoration.get(), &Decoration::damaged, this, [this](const QRegion&) {
+        update();
+    });
+    connect(m_decoration.get(), &Decoration::bordersChanged, this, &KdeDecorationButtons::recalculateBounds);
+    connect(m_decoration.get(), &Decoration::titleBarChanged, this, &KdeDecorationButtons::recalculateBounds);
+
+    const auto allBtns = m_decoration->findChildren<DecorationButton*>();
+    for (auto* b : allBtns) {
+        if (!b)
+            continue;
+        if (b->type() != DecorationButtonType::Minimize
+            && b->type() != DecorationButtonType::Maximize
+            && b->type() != DecorationButtonType::Close) {
+            continue;
+        }
+        if (b->type() == DecorationButtonType::Maximize)
+            b->setChecked(m_windowMaximized);
+
+        m_buttons.append(b);
+        connect(b, &DecorationButton::hoveredChanged, this, [this](bool) { update(); });
+        connect(b, &DecorationButton::pressedChanged, this, [this](bool) { update(); });
+        connect(b, &DecorationButton::checkedChanged, this, [this](bool) { update(); });
+        connect(b, &DecorationButton::geometryChanged, this, &KdeDecorationButtons::recalculateBounds);
+        connect(b, &DecorationButton::visibilityChanged, this, &KdeDecorationButtons::recalculateBounds);
+    }
+
+    recalculateBounds();
+}
+
+void KdeDecorationButtons::recalculateBounds() {
+    QRectF total;
+    for (const auto& b : m_buttons) {
+        if (b && b->isVisible() && b->geometry().isValid() && !b->geometry().isEmpty()) {
+            total = total.isNull() ? b->geometry() : total.united(b->geometry());
+        }
+    }
+    m_buttonsBounds = total;
+    if (!m_decoration || total.isEmpty()) {
+        setImplicitSize(0, 0);
+    } else {
+        const qreal tbHeight = std::max({ 30.0, m_decoration->borderTop(), m_decoration->titleBar().bottom(), total.bottom() });
+        if (m_side == QLatin1String("left")) {
+            const qreal winLeft = m_decoration->borderLeft();
+            setImplicitSize(std::max(1.0, std::ceil(total.right() - winLeft)), std::ceil(tbHeight));
+        } else {
+            const qreal winRight = m_decoration->rect().width() - m_decoration->borderRight();
+            setImplicitSize(std::max(1.0, std::ceil(winRight - total.left())), std::ceil(tbHeight));
+        }
+    }
+
+    const bool nowHas = !total.isEmpty();
+    if (m_hasButtons != nowHas) {
+        m_hasButtons = nowHas;
+        emit hasButtonsChanged();
+    }
+    update();
+}
+
+QPointF KdeDecorationButtons::decoOffset() const {
+    if (!m_decoration || m_buttonsBounds.isEmpty())
+        return QPointF();
+    if (m_side == QLatin1String("left")) {
+        return QPointF(-m_decoration->borderLeft(), 0.0);
+    }
+    const qreal winRight = m_decoration->rect().width() - m_decoration->borderRight();
+    return QPointF(width() - winRight, 0.0);
+}
+
+QPointF KdeDecorationButtons::toDecoPos(const QPointF& localPos) const {
+    return localPos - decoOffset();
+}
+
+void KdeDecorationButtons::clearHoverState() {
+    if (!m_decoration)
+        return;
+    QHoverEvent he(QEvent::HoverLeave, QPointF(-100, -100), QPointF(-100, -100), QPointF(-100, -100));
+    QCoreApplication::sendEvent(m_decoration.get(), &he);
+    update();
+}
+
+void KdeDecorationButtons::paint(QPainter* painter) {
+    if (!m_decoration || m_buttons.isEmpty() || m_buttonsBounds.isEmpty())
+        return;
+
+    painter->save();
+    painter->setRenderHint(QPainter::Antialiasing, true);
+    painter->setRenderHint(QPainter::SmoothPixmapTransform, true);
+    painter->translate(decoOffset());
+
+    for (const auto& b : m_buttons) {
+        if (b && b->isVisible())
+            b->paint(painter, b->geometry());
+    }
+
+    painter->restore();
+}
+
+void KdeDecorationButtons::hoverEnterEvent(QHoverEvent* event) {
+    if (!m_decoration)
+        return;
+    const QPointF pos = toDecoPos(event->position());
+    const QPointF oldPos = toDecoPos(event->oldPosF());
+    QHoverEvent he(QEvent::HoverEnter, pos, pos, oldPos, event->modifiers(), event->pointingDevice());
+    QCoreApplication::sendEvent(m_decoration.get(), &he);
+    update();
+}
+
+void KdeDecorationButtons::hoverMoveEvent(QHoverEvent* event) {
+    if (!m_decoration)
+        return;
+    const QPointF pos = toDecoPos(event->position());
+    const QPointF oldPos = toDecoPos(event->oldPosF());
+    QHoverEvent he(QEvent::HoverMove, pos, pos, oldPos, event->modifiers(), event->pointingDevice());
+    QCoreApplication::sendEvent(m_decoration.get(), &he);
+    update();
+}
+
+void KdeDecorationButtons::hoverLeaveEvent(QHoverEvent* event) {
+    if (!m_decoration)
+        return;
+    const QPointF oldPos = toDecoPos(event->oldPosF());
+    QHoverEvent he(QEvent::HoverLeave, QPointF(-100, -100), QPointF(-100, -100), oldPos,
+        event->modifiers(), event->pointingDevice());
+    QCoreApplication::sendEvent(m_decoration.get(), &he);
+    update();
+}
+
+void KdeDecorationButtons::mousePressEvent(QMouseEvent* event) {
+    if (!m_decoration)
+        return;
+    const QPointF pos = toDecoPos(event->position());
+    QMouseEvent me(QEvent::MouseButtonPress, pos, pos, event->globalPosition(),
+        event->button(), event->buttons(), event->modifiers(), event->pointingDevice());
+    QCoreApplication::sendEvent(m_decoration.get(), &me);
+    event->accept();
+    update();
+}
+
+void KdeDecorationButtons::mouseMoveEvent(QMouseEvent* event) {
+    if (!m_decoration)
+        return;
+    const QPointF pos = toDecoPos(event->position());
+    QMouseEvent me(QEvent::MouseMove, pos, pos, event->globalPosition(),
+        event->button(), event->buttons(), event->modifiers(), event->pointingDevice());
+    QCoreApplication::sendEvent(m_decoration.get(), &me);
+    event->accept();
+    update();
+}
+
+void KdeDecorationButtons::mouseReleaseEvent(QMouseEvent* event) {
+    if (!m_decoration)
+        return;
+    const QPointF pos = toDecoPos(event->position());
+    QMouseEvent me(QEvent::MouseButtonRelease, pos, pos, event->globalPosition(),
+        event->button(), event->buttons(), event->modifiers(), event->pointingDevice());
+    QCoreApplication::sendEvent(m_decoration.get(), &me);
+    event->accept();
+    update();
+}
