+class KdeDecoSettings : public DecorationSettingsPrivateV2 {
+public:
+    explicit KdeDecoSettings(DecorationSettings* parent, KdeDecorationButtons* owner)
+        : DecorationSettingsPrivateV2(parent)
+        , m_owner(owner) {}
+
+    bool isOnAllDesktopsAvailable() const override { return true; }
+    bool isAlphaChannelSupported() const override { return true; }
+    bool isCloseOnDoubleClickOnMenu() const override { return false; }
+    bool isAlwaysShowExcludeFromCapture() const override { return false; }
+
+    QList<DecorationButtonType> decorationButtonsLeft() const override {
+        return m_owner ? m_owner->activeButtonsLeft() : QList<DecorationButtonType>{};
+    }
+
+    QList<DecorationButtonType> decorationButtonsRight() const override {
+        return m_owner ? m_owner->activeButtonsRight() : QList<DecorationButtonType>{};
+    }
+
+    BorderSize borderSize() const override {
+        return m_owner ? m_owner->activeBorderSize() : BorderSize::Normal;
+    }
+
+private:
+    QPointer<KdeDecorationButtons> m_owner;
+};
+
+class KdeDecoWindow : public DecoratedWindowPrivateV4 {
+public:
+    explicit KdeDecoWindow(DecoratedWindow* client, Decoration* decoration, KdeDecorationButtons* owner)
+        : DecoratedWindowPrivateV4(client, decoration)
+        , m_owner(owner) {}
+
+    bool isActive() const override { return m_owner ? m_owner->windowActive() : true; }
+    QString caption() const override { return QString(); }
+    bool isOnAllDesktops() const override { return false; }
+    bool isShaded() const override { return false; }
+    QIcon icon() const override { return QIcon(); }
+    bool isMaximized() const override { return m_owner ? m_owner->windowMaximized() : false; }
+    bool isMaximizedHorizontally() const override { return isMaximized(); }
+    bool isMaximizedVertically() const override { return isMaximized(); }
+    bool isKeepAbove() const override { return false; }
+    bool isKeepBelow() const override { return false; }
+
+    bool isCloseable() const override { return true; }
+    bool isMaximizeable() const override { return true; }
+    bool isMinimizeable() const override { return true; }
+    bool providesContextHelp() const override { return false; }
+    bool isModal() const override { return false; }
+    bool isShadeable() const override { return false; }
+    bool isMoveable() const override { return true; }
+    bool isResizeable() const override { return true; }
+
+    qreal width() const override { return 360.0; }
+    qreal height() const override { return 80.0; }
+    QSizeF size() const override { return QSizeF(360.0, 80.0); }
+    QPalette palette() const override {
+        return KColorScheme::createApplicationPalette(KSharedConfig::openConfig(QStringLiteral("kdeglobals")));
+    }
+    Qt::Edges adjacentScreenEdges() const override { return Qt::Edges(); }
+    qreal scale() const override { return 1.0; }
+    qreal nextScale() const override { return 1.0; }
+
+    void requestShowToolTip(const QString&) override {}
+    void requestHideToolTip() override {}
+    void requestClose() override {
+        if (m_owner)
+            m_owner->notifyCloseRequested();
+    }
+    void requestToggleMaximization(Qt::MouseButtons) override {
+        if (m_owner)
+            m_owner->notifyMaximizeRequested();
+    }
+    void requestMinimize() override {
+        if (m_owner)
+            m_owner->notifyMinimizeRequested();
+    }
+    void requestContextHelp() override {}
+    void requestToggleOnAllDesktops() override {}
+    void requestToggleShade() override {}
+    void requestToggleKeepAbove() override {}
+    void requestToggleKeepBelow() override {}
+    void requestShowWindowMenu(const QRect&) override {}
+
+    QColor color(ColorGroup group, ColorRole role) const override {
+        if (group == ColorGroup::Warning && role == ColorRole::Foreground) {
+            return QColor(QStringLiteral("#da4453"));
+        }
+        const bool act = (group == ColorGroup::Active);
+        if (role == ColorRole::Foreground) {
+            return QColor(act ? QStringLiteral("#eff0f1") : QStringLiteral("#bdc3c7"));
+        }
+        return QColor(act ? QStringLiteral("#202328") : QStringLiteral("#1a1c20"));
+    }
+
+    QString windowClass() const override { return QStringLiteral("quickshell"); }
+    bool hasApplicationMenu() const override { return false; }
+    bool isApplicationMenuActive() const override { return false; }
+    void showApplicationMenu(int) override {}
+    void requestShowApplicationMenu(const QRect&, int) override {}
+    QString applicationMenuServiceName() const override { return QString(); }
+    QString applicationMenuObjectPath() const override { return QString(); }
+    void popup(const Positioner&, QMenu*) override {}
+    bool isExcludedFromCapture() const override { return false; }
+    void requestToggleExcludeFromCapture() override {}
+
+    DecoratedWindow* decoratedWindow() { return window(); }
+
+private:
+    QPointer<KdeDecorationButtons> m_owner;
+};
+
+class KdeDecoBridge : public DecorationBridge {
+public:
+    explicit KdeDecoBridge(KdeDecorationButtons* owner)
+        : DecorationBridge(owner)
+        , m_owner(owner) {}
+
+    std::unique_ptr<DecoratedWindowPrivate> createClient(DecoratedWindow* client, Decoration* decoration) override {
+        auto win = std::make_unique<KdeDecoWindow>(client, decoration, m_owner);
+        m_lastWindow = win.get();
+        return win;
+    }
+
+    std::unique_ptr<DecorationSettingsPrivate> settings(DecorationSettings* parent) override {
+        return std::make_unique<KdeDecoSettings>(parent, m_owner);
+    }
+
+    KdeDecoWindow* lastWindow() const { return m_lastWindow; }
+    void clearLastWindow() { m_lastWindow = nullptr; }
+
+private:
+    QPointer<KdeDecorationButtons> m_owner;
+    KdeDecoWindow* m_lastWindow = nullptr;
+};
