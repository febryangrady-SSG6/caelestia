From 0c36bcf57d73e1618facaf19f7ded2737355af0f Mon Sep 17 00:00:00 2001
From: Febryan Grady <febryan.grady@binus.edu>
Date: Sun, 22 Nov 2026 02:46:21 +0700
Subject: [PATCH 41/47] fix(blur): fix top-anchored BlurOffsets, add vertical
 FilletBlur, and snap edge popouts

---
 shell/modules/bar/popouts/ClipWrapper.qml  |  30 +++--
 shell/modules/drawers/ContentWindow.qml    |  94 ++++++++++++---
 shell/modules/drawers/Panels.qml           |   8 +-
 shell/modules/drawers/blur/BlurOffsets.qml |   8 +-
 shell/modules/drawers/blur/FilletBlur.qml  | 133 ++++++++++++++-------
 5 files changed, 196 insertions(+), 77 deletions(-)

diff --git a/shell/modules/bar/popouts/ClipWrapper.qml b/shell/modules/bar/popouts/ClipWrapper.qml
index 0b5d1ee4..f622483b 100644
--- a/shell/modules/bar/popouts/ClipWrapper.qml
+++ b/shell/modules/bar/popouts/ClipWrapper.qml
@@ -62,6 +62,9 @@ Item {
     readonly property real lampScaleY: (isLampActive && !isHorizontal && content.nonAnimHeight > 0) ? (height / content.nonAnimHeight) : 1
 
     readonly property real clampedOffsetScale: Math.max(0, offsetScale)
+    // Snap into the screen border when within its smin blend zone (smoothing) so the popout
+    // attaches flush to the border without leaving an unblurred gap between them.
+    readonly property real snapThreshold: !activePanel.isIsland ? Config.border.smoothing : 0
     // Where x is heading; x itself animates towards it.
     readonly property real targetX: {
         if (content.isDetached)
@@ -72,15 +75,21 @@ Item {
 
             // An item left of the open sidebar gets its popout kept clear of it, so
             // the sidebar doesn't have to be pushed out of the way.
+            const avoidingSidebar = activePanel === bar && root.visibilities.sidebar && !content.underSidebar;
             const idealX = content.currentCenter - parent.leftMargin - content.nonAnimWidth / 2;
+            let res;
             if (effectivePanelWidth >= content.nonAnimWidth) {
                 const minX = Math.max(0, panelLeft);
                 const maxX = Math.min(parent.width - content.nonAnimWidth, effectivePanelRight - content.nonAnimWidth);
-                if (minX <= maxX)
-                    return Math.max(minX, Math.min(idealX, maxX));
-                return minX;
+                res = minX <= maxX ? Math.max(minX, Math.min(idealX, maxX)) : minX;
+            } else {
+                res = Math.max(0, Math.min(parent.width - content.nonAnimWidth, effectivePanelCenterX - content.nonAnimWidth / 2));
             }
-            return Math.max(0, Math.min(parent.width - content.nonAnimWidth, effectivePanelCenterX - content.nonAnimWidth / 2));
+            if (!avoidingSidebar && parent.width - Math.floor(res + content.nonAnimWidth) <= root.snapThreshold)
+                return Math.max(parent.width - content.nonAnimWidth, 0);
+            if (res <= root.snapThreshold)
+                return 0;
+            return res;
         }
         if (activePanel.position === "right")
             return parent.width - implicitWidth;
@@ -97,14 +106,19 @@ Item {
         }
 
         const idealY = content.currentCenter - parent.topMargin - content.nonAnimHeight / 2;
+        let res;
         if (panelHeight >= content.nonAnimHeight) {
             const minY = Math.max(0, panelTop);
             const maxY = Math.min(parent.height - content.nonAnimHeight, panelBottom - content.nonAnimHeight);
-            if (minY <= maxY)
-                return Math.max(minY, Math.min(idealY, maxY));
-            return minY;
+            res = minY <= maxY ? Math.max(minY, Math.min(idealY, maxY)) : minY;
+        } else {
+            res = Math.max(0, Math.min(parent.height - content.nonAnimHeight, panelCenterY - content.nonAnimHeight / 2));
         }
-        return Math.max(0, Math.min(parent.height - content.nonAnimHeight, panelCenterY - content.nonAnimHeight / 2));
+        if (parent.height - Math.floor(res + content.nonAnimHeight) <= root.snapThreshold)
+            return Math.max(parent.height - content.nonAnimHeight, 0);
+        if (res <= root.snapThreshold)
+            return 0;
+        return res;
     }
 
     visible: width > 0 && height > 0
