From cc57f39d34be2352e0b8e20b8dfb9d45a81d8d02 Mon Sep 17 00:00:00 2001
From: Febryan Grady <febryan.grady@binus.edu>
Date: Sun, 22 Nov 2026 03:10:39 +0700
Subject: [PATCH 44/47] feat(launcher): use single-line macOS Launchpad-style
 app tile labels

---
 shell/modules/launcher/items/AppTile.qml | 73 +++++++++++++++++++++---
 1 file changed, 65 insertions(+), 8 deletions(-)

diff --git a/shell/modules/launcher/items/AppTile.qml b/shell/modules/launcher/items/AppTile.qml
index 84644a97..23f78e48 100644
--- a/shell/modules/launcher/items/AppTile.qml
+++ b/shell/modules/launcher/items/AppTile.qml
@@ -29,16 +29,16 @@ Item {
     readonly property bool hovered: tileArea.containsMouse && !favArea.containsMouse && root.nameOverflows
     readonly property bool flipped: root.hovered && root.nameMode === LauncherNameOverflow.Flip
     readonly property bool shrunk: root.hovered && root.nameMode === LauncherNameOverflow.Shrink
-    readonly property bool labelTruncated: root.flipped ? (flipFace.item?.truncated ?? false) : name.truncated
+    readonly property bool labelTruncated: root.flipped ? (flipFace.item?.isTruncated ?? false) : name.isTruncated
     readonly property int maxNameLines: nameMetrics.height > 0 ? Math.max(1, Math.floor((root.implicitHeight - Tokens.spacing.small) / nameMetrics.height)) : 1
-    // A long name reads in full rather than as an ellipsis; hovering with the shrink
-    // overflow mode halves the icon and buys it a line more.
-    readonly property int labelLines: root.shrunk ? 3 : 2
+    // Single-line macOS Launchpad-style label at rest; hovering with the shrink
+    // overflow mode halves the icon and buys it a second line.
+    readonly property int labelLines: root.shrunk ? 2 : 1
     // The icon takes whatever height is left once the label has its lines, so
     // a large font or a long name can no longer push the block past the tile.
     readonly property int lineHeight: Math.max(1, Math.round(nameMetrics.height))
     readonly property int labelHeight: root.lineHeight * root.labelLines
-    readonly property int _baseLabelHeight: root.lineHeight * 2
+    readonly property int _baseLabelHeight: root.lineHeight
     readonly property int _verticalPadding: Math.round((Tokens.padding.extraSmall + Tokens.padding.small) / 2)
     readonly property int baseIconSize: Math.min(Math.round(root.implicitWidth * 0.44), Math.max(16, root.implicitHeight - root._baseLabelHeight - root._verticalPadding * 2 - Tokens.spacing.extraSmall))
 
@@ -49,7 +49,7 @@ Item {
         id: nameMetrics
 
         font: name.font
-        text: name.text
+        text: root.modelData?.name ?? ""
     }
 
     StyledRect {
@@ -236,13 +236,70 @@ Item {
     }
 
     component NameLabel: StyledText {
+        id: labelRoot
+
         required property int maxLines
+        readonly property string rawText: (root.modelData?.name ?? "").trim()
+        readonly property var layoutResult: {
+            const raw = rawText;
+            const maxW = width;
+            if (!raw || maxW <= 0 || maxLines <= 0)
+                return { text: raw, truncated: false };
+            if (maxLines === 1 || labelMetrics.advanceWidth(raw) <= maxW)
+                return { text: raw, truncated: false };
+
+            const words = raw.split(/\s+/);
+            const lines = [];
+            let idx = 0;
+            let wasTruncated = false;
+
+            while (idx < words.length && lines.length < maxLines) {
+                const isLastLine = lines.length === maxLines - 1;
+                if (isLastLine) {
+                    const rest = words.slice(idx).join(" ");
+                    if (labelMetrics.advanceWidth(rest) <= maxW) {
+                        lines.push(rest);
+                    } else {
+                        lines.push(labelMetrics.elidedText(rest, Qt.ElideRight, maxW));
+                        wasTruncated = true;
+                    }
+                    idx = words.length;
+                    break;
+                }
 
-        text: root.modelData?.name ?? ""
+                let line = words[idx++];
+                if (labelMetrics.advanceWidth(line) > maxW) {
+                    lines.push(labelMetrics.elidedText(line, Qt.ElideRight, maxW));
+                    wasTruncated = true;
+                    continue;
+                }
+
+                while (idx < words.length) {
+                    const candidate = line + " " + words[idx];
+                    if (labelMetrics.advanceWidth(candidate) <= maxW) {
+                        line = candidate;
+                        idx++;
+                    } else {
+                        break;
+                    }
+                }
+                lines.push(line);
+            }
+
+            return { text: lines.join("\n"), truncated: wasTruncated };
+        }
+        readonly property bool isTruncated: layoutResult.truncated || truncated
+
+        FontMetrics {
+            id: labelMetrics
+            font: labelRoot.font
+        }
+
+        text: layoutResult.text
         color: root.selected ? Colours.palette.m3onSurface : Colours.palette.m3onSurfaceVariant
         font: root.simple ? Tokens.font.label.builders.medium.size(9).build() : Tokens.font.label.medium
         elide: Text.ElideRight
-        wrapMode: Text.Wrap
+        wrapMode: Text.NoWrap
         maximumLineCount: maxLines
         // The label is clipped by the tile anyway, so it gets the tile's full width: the
         // 24px inset it used to keep left a quarter of a 96px tile showing an ellipsis.
-- 
2.56.1

