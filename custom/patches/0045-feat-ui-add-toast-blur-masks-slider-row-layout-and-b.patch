 import Quickshell.Wayland
 import Caelestia.Config
 import Caelestia.Services
@@ -73,6 +74,38 @@ Singleton {
         id: dummy
     }
 
+    // Keep KWin's Rounded Corners effect radius in sync with Caelestia's Border rounding.
+    Timer {
+        id: kwinCornerSyncTimer
+
+        interval: 150
+        onTriggered: {
+            const r = Math.max(0, Math.round(GlobalConfig.border.rounding));
+            kwinCornerSyncProc.command = [
+                "bash", "-c",
+                `r=${r}; cur=$(kreadconfig6 --file kwinrc --group Round-Corners --key Size 2>/dev/null || true); ` +
+                `if [ "$cur" != "$r" ]; then ` +
+                `kwriteconfig6 --file kwinrc --group Round-Corners --key Size "$r" && ` +
+                `kwriteconfig6 --file kwinrc --group Round-Corners --key InactiveCornerRadius "$r" && ` +
+                `qdbus6 org.kde.KWin /Effects reconfigureEffect kwin4_effect_shapecorners >/dev/null 2>&1 || true; fi`
+            ];
+            kwinCornerSyncProc.running = true;
+        }
+    }
+
+    Process {
+        id: kwinCornerSyncProc
+    }
+
+    Connections {
+        target: GlobalConfig.border
+        function onRoundingChanged(): void {
+            kwinCornerSyncTimer.restart();
+        }
+    }
+
+    Component.onCompleted: kwinCornerSyncTimer.restart()
+
     // building the window costs seconds of CPU, so it is built once while idle and then only hidden/shown
     Timer {
         running: true
