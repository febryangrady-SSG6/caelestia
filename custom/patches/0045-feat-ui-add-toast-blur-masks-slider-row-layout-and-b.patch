From dc501511da82e680b9c113b3c64f60fef4811bf2 Mon Sep 17 00:00:00 2001
From: Febryan Grady <febryan.grady@binus.edu>
Date: Mon, 23 Nov 2026 22:16:20 +0700
Subject: [PATCH 45/47] feat(ui): add toast blur masks, slider row layout, and
 blur/window updates

---
 shell/components/controls/SliderRow.qml    |  43 +++--
 shell/modules/drawers/ContentWindow.qml    |  22 +++
 shell/modules/drawers/blur/BlurCorners.qml | 212 ++++++++++-----------
 shell/modules/drawers/blur/BlurOffsets.qml |  30 ++-
 shell/modules/nexus/WindowFactory.qml      |  35 +++-
 shell/modules/utilities/toasts/Toasts.qml  |  14 ++
 6 files changed, 224 insertions(+), 132 deletions(-)

diff --git a/shell/components/controls/SliderRow.qml b/shell/components/controls/SliderRow.qml
index 6c242175..23e24b59 100644
--- a/shell/components/controls/SliderRow.qml
+++ b/shell/components/controls/SliderRow.qml
@@ -11,7 +11,7 @@ import qs.modules.nexus.common
 StyledRect {
     id: root
 
-    property alias icon: icon.text
+    property string icon
     property alias label: label.text
     property alias valueLabel: valueLabel.text
     property string subtext
@@ -46,7 +46,7 @@ StyledRect {
     }
 
     Layout.fillWidth: true
-    implicitHeight: rowLayout.implicitHeight + rowLayout.anchors.margins + rowLayout.anchors.topMargin
+    implicitHeight: rowLayout.implicitHeight + rowLayout.anchors.topMargin + rowLayout.anchors.bottomMargin
     color: isSelected ? Colours.layer(Colours.palette.m3surfaceContainerHigh, 4) : Colours.tPalette.m3surfaceContainer
     border.width: isSelected ? 2 : 0
     border.color: Colours.palette.m3primary
@@ -76,32 +76,35 @@ StyledRect {
         id: rowLayout
 
         anchors.fill: parent
-        anchors.margins: spacious ? Tokens.padding.largeIncreased : Tokens.padding.medium
-        anchors.topMargin: spacious ? Tokens.padding.large : Tokens.padding.small
-        // Keep the same right inset as ToggleRow/StepperRow (12px) even when
-        // spacious, so reset icons line up in one column across every row type.
+        anchors.leftMargin: spacious ? Tokens.padding.largeIncreased : Tokens.padding.medium
         anchors.rightMargin: Tokens.padding.medium
-        spacing: spacious ? Tokens.spacing.medium : Tokens.spacing.small
+        anchors.topMargin: spacious ? Tokens.padding.large : Tokens.padding.medium
+        anchors.bottomMargin: spacious ? Tokens.padding.largeIncreased : Tokens.padding.small
+        spacing: Tokens.spacing.medium
+
+        IconButton {
+            visible: root.icon !== "" && root.iconClickable
+            Layout.alignment: Qt.AlignVCenter
+            icon: root.icon
+            type: IconButton.Tonal
+            isRound: true
+            enabled: root.enabled
+            onClicked: root.iconClicked()
+        }
 
         MaterialIcon {
             id: icon
 
-            visible: text !== ""
+            visible: root.icon !== "" && !root.iconClickable
+            Layout.alignment: Qt.AlignVCenter
+            text: root.icon
             color: root.enabled ? Colours.palette.m3onSurfaceVariant : Colours.disabledContent
-            fontStyle: spacious ? Tokens.font.icon.medium : Tokens.font.icon.small
-
-            MouseArea {
-                anchors.fill: parent
-                anchors.margins: -6
-                enabled: root.iconClickable
-                cursorShape: enabled ? Qt.PointingHandCursor : Qt.ArrowCursor
-                onClicked: root.iconClicked()
-            }
+            fontStyle: Tokens.font.icon.medium
         }
 
         ColumnLayout {
             Layout.fillWidth: true
-            spacing: spacious ? Tokens.spacing.medium : Tokens.spacing.extraSmall
+            spacing: spacious ? Tokens.spacing.medium : Tokens.spacing.small
 
             RowLayout {
                 Layout.fillWidth: true
@@ -154,13 +157,13 @@ StyledRect {
                 }
 
                 Layout.fillWidth: true
-                implicitHeight: spacious ? Tokens.padding.medium * 2 : Tokens.padding.large
+                implicitHeight: root.spacious ? Tokens.padding.medium * 2 + Tokens.padding.small : Tokens.padding.large * 2
 
                 StyledSlider {
                     anchors.left: parent.left
                     anchors.right: parent.right
                     anchors.verticalCenter: parent.verticalCenter
-                    implicitHeight: parent.implicitHeight
+                    implicitHeight: root.spacious ? Tokens.padding.medium * 2 : Tokens.padding.large
 
                     radius: Tokens.rounding.small
                     value: root.value
diff --git a/shell/modules/drawers/ContentWindow.qml b/shell/modules/drawers/ContentWindow.qml
index 497a6f6d..51d9d852 100644
--- a/shell/modules/drawers/ContentWindow.qml
+++ b/shell/modules/drawers/ContentWindow.qml
@@ -1325,6 +1325,28 @@ StyledWindow {
             hAnchor: "none"
             offsetScale: panels.floatingOsd.offsetScale
         }
+        ToastBlurMask { toastIndex: 0 }
+        ToastBlurMask { toastIndex: 1 }
+        ToastBlurMask { toastIndex: 2 }
+        ToastBlurMask { toastIndex: 3 }
+        ToastBlurMask { toastIndex: 4 }
+        ToastBlurMask { toastIndex: 5 }
+    }
+
+    component ToastBlurMask: BlurMask {
+        required property int toastIndex
+
+        readonly property Item toastItem: (panels.toasts.visible && GlobalConfig.utilities.toasts.transparency && !(GameMode.enabled && GlobalConfig.utilities.gameMode.disableToastTransparency) && toastIndex < panels.toasts.toastItems.length) ? panels.toasts.toastItems[toastIndex] : null
+
+        target: (toastItem && toastItem.opacity > 0.01) ? toastItem : null
+        contentItem: root.contentItem
+        blurOffsetTop: root.blurOffsetTop
+        blurOffsetBottom: root.blurOffsetBottom
+        blurOffsetLeft: root.blurOffsetLeft
+        blurOffsetRight: root.blurOffsetRight
+        vAnchor: "none"
+        hAnchor: "none"
+        radius: toastItem ? toastItem.radius : Tokens.rounding.large
     }
 
     // Drawn last so the drag ghost passes over the bar and the box it is heading for
diff --git a/shell/modules/drawers/blur/BlurCorners.qml b/shell/modules/drawers/blur/BlurCorners.qml
index 8f499ff7..29c6e912 100644
--- a/shell/modules/drawers/blur/BlurCorners.qml
+++ b/shell/modules/drawers/blur/BlurCorners.qml
@@ -17,7 +17,7 @@ Region {
     required property real rLeft
     required property real rRight
 
-    property int steps: Math.max(1, blurQuality)
+    property int steps: Math.min(100, Math.max(1, blurQuality, Math.ceil(Math.max(rTL, rTR, rBL, rBR))))
 
     // The strip geometry depends only on steps, so it is computed once here
     // instead of in every region binding on every animation frame.
@@ -29,11 +29,11 @@ Region {
             const prev = Math.ceil((i - 1) * steps / 100);
             active.push(m > prev && (root.intersection === Intersection.Subtract || m < steps));
             yo.push(m / steps);
-            // Use inscribed steps (m/steps) for additive blur masks so 1-bit blur rectangles
-            // never poke outside the anti-aliased rounded corner; keep circumscribed steps
-            // (prev/steps) when subtracting concave screen corners.
-            const edge = root.intersection === Intersection.Subtract ? (prev / steps) : (m / steps);
-            xVal.push(Math.sqrt(1 - Math.pow(edge, 2)));
+            // Sample at the vertical midpoint of each 1px strip for additive blur masks so the
+            // rounded corner closely follows the anti-aliased arc without jagged inset steps;
+            // keep circumscribed steps (prev/steps) when subtracting concave screen corners.
+            const edge = root.intersection === Intersection.Subtract ? (prev / steps) : ((m - 0.5) / steps);
+            xVal.push(Math.sqrt(Math.max(0, 1 - Math.pow(edge, 2))));
         }
         return { active, yo, xVal };
     }
