From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Febryan Grady <febryan.grady@binus.edu>
Date: Tue, 24 Nov 2026 23:40:00 +0700
Subject: [PATCH 49/49] fix(colors): disable KDE inactive selection color shift

---
 src/bin/caelestia-color | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/src/bin/caelestia-color b/src/bin/caelestia-color
index 50a7c772..c89e4b11 100755
--- a/src/bin/caelestia-color
+++ b/src/bin/caelestia-color
@@ -861,6 +861,10 @@ def cmd_kde_selection(scheme_file: str, colors_file: str) -> int:
             if len(val_hex) != 6 or contrast_ratio(surface, val_hex) < 4.5:
                 lines[index] = f"ForegroundNormal=#{comp_fg}"
                 changed = True
+        elif section == "[ColorEffects:Inactive]" and key == "ChangeSelectionColor":
+            if value.strip().lower() != "false":
+                lines[index] = "ChangeSelectionColor=false"
+                changed = True
 
     if changed:
         atomic_write(path, "\n".join(lines) + "\n")
